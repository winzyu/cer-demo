# ---- Runtime ----
NODE_ENV=development
PORT=8000
# silent | error | warn | info. Honored by src/utils/logger.ts: a level enables itself and
# everything more severe, so `error` silences the info and warn diagnostics.
LOG_LEVEL=info

# ---- Firestore ----
# Leave FIRESTORE_PROJECT_ID unset to use Application Default Credentials
# (e.g. `gcloud auth application-default login`).
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)

# ---- Fireworks (OpenAI-compatible) ----
# Required for the chat/LLM phase; NOT required for the skeleton to boot or pass /health.
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
LLM_MODEL=accounts/fireworks/models/gpt-oss-20b
# Keep generous: gpt-oss emits reasoning tokens before visible output and returns an
# empty answer if the budget runs out.
LLM_MAX_TOKENS=4096
# Sampling temperature. 0 by default: required by the N2 bake-off (sampling variance across arms
# would measure the sampler, not the retrieval strategy) and the right default for a grounded
# assistant regardless.
LLM_TEMPERATURE=0
# Sent as the OpenAI `user` field; drives Fireworks serverless cache affinity.
FIREWORKS_USER=clean-earth-rag

# ---------------------------------------------------------------------------
# Clean Earth device API (sensor data) — Phase N3
# ---------------------------------------------------------------------------
# Base URL of the Clean Earth backend, INCLUDING the /api/v1 suffix.
# Production:  https://cer-api-98242557946.us-central1.run.app/api/v1
# Local dev:   http://localhost:5001/api/v1
# There is NO QA mirror — "qa" selects a different Firestore database on the same
# deployment, not a separate host. Live calls hit production data.
DEVICE_API_BASE_URL=https://cer-api-98242557946.us-central1.run.app/api/v1
# DEV ONLY. A bearer JWT for manual testing, obtained from POST /users/login
# (or copied from the dashboard: DevTools -> Application -> Local Storage -> "token").
# These tokens are minted WITHOUT an expiry, so a leaked one stays valid forever.
# Responses are scoped to the token holder's organization — a wrong-org token returns
# a short, plausible device list rather than an error.
# In production the CALLER's token is forwarded instead — a shared service token
# would let any chat user read every device. Never commit a real value.
DEVICE_API_TOKEN=
DEVICE_API_TIMEOUT_MS=10000
# Optional alternative to DEVICE_API_TOKEN: `npm run explore:devices` will log in and
# mint a token for the run. Never written to the recorded output. See docs/migration/DEVICE_API.md §5.
CER_EMAIL=
CER_PASSWORD=
# Which pod query_sensor_data answers about when the model names none. Leave UNSET to make
# the tool ask. The registry is not stable — the count moved 21 -> 17 during exploration, so
# nothing should hard-code it (docs/migration/DEVICE_API.md §2). The two cleared test pods are in
# different water bodies on opposite coasts, so a wrong default gives confident answers about the
# wrong site. Set it only for a genuinely single-pod deployment.
#   Algalita Pod         dev:351077454569099   salt-water
#   Old Woman Creek 2026 dev:351077454567580   fresh-water
SENSOR_DEVICE_LABEL=
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# ---- Tool calling (Phase N3) ----
# ⚠️ SENSOR_TOOL adds a tool block to the SYSTEM PROMPT, which is a pinned control for the
# Phase N2 retrieval bake-off (docs/RETRIEVAL_BAKEOFF.md §4). ◆G7 is still open — the sweep is
# captured but ungraded. With this OFF the prompt is byte-identical to the one all three arms
# ran against and no tools are attached to a request; a hash in test/unit/prompt.test.ts pins
# that. Turn it ON to use query_sensor_data, but do NOT capture bake-off arms with it on —
# those runs are not comparable to the captured three.
SENSOR_TOOL=false

# ⚠️ REPORT_TOOL adds generate_report and a report-vs-stat routing rule to the SYSTEM PROMPT --
# same pinned-control caveat as SENSOR_TOOL above (docs/RETRIEVAL_BAKEOFF.md §4). Needs
# DEVICE_API_BASE_URL configured (see above) to actually produce a report; generated PDFs are
# written to local disk (generated_reports/) and do not survive a redeploy.
REPORT_TOOL=false

# Tool-enabled rounds before the loop forces a text-only answer. Legacy was 5, which cannot fit
# the six-parameter eval fixture (one call per metric, plus follow-ups). Raising it is N5's
# "raise the tool-round cap" item landing early. A stuck model burns one paid LLM call per
# round, so the loop serves repeated identical calls from cache rather than re-running them.
MAX_TOOL_ROUNDS=16
# Rows an aggregation:"raw" call may return. A cap, not a page size — raw output goes straight
# into the next prompt.
RAW_LIMIT=200

# ---------------------------------------------------------------------------
# Query quota (POST /api/v1/chat)
# ---------------------------------------------------------------------------
# Lets the team pick a usage policy from .env instead of from code. The upstream Gilligan
# backend hard-codes its policy in GilliganService.checkQuota — "fewer than 2 messages by this
# user in the last week, OR fewer than 10 by their organization this month, OR any active Stripe
# subscription, OR role=superadmin" — and those numbers are exactly what is still being decided
# here. This block can express that shape without being stuck with it, and adds a token
# dimension so a request count and a spend cap can be compared on the same deployment.
#
# ⚠️ EVERYTHING BELOW IS OFF BY DEFAULT and must stay that way in this file. A gate that
# silently starts refusing requests looks like a product bug, and this repo is mid-experiment
# with pinned controls (SENSOR_TOOL, REPORT_TOOL, the system-prompt hash) — a capture run that
# died halfway through on a 429 is a voided run.

# Master switch. false => nothing is counted, nothing is refused, whatever the limits below say.
# "Off" is deliberately ONE state, not something you have to infer from four other variables.
QUERY_QUOTA=false

# Chat requests allowed per key per window.
#   unlimited  -> no ceiling on this dimension (the default)
#   <integer>  -> that many requests, then 429 quota_requests_exceeded
#   0          -> refuse everything; a usable kill switch, warned about at startup
# "unlimited" is a real value, spelled out. Do NOT express "no limit" as a huge number: 99999999
# still refuses somebody eventually, and it is indistinguishable from a typo. An unset or empty
# value falls back to unlimited, but anything else that is not a non-negative integer is a HARD
# STARTUP ERROR — "none", "off", "-1" and "∞" are all things people type, and reading any of them
# as "unlimited" would hand an unbounded deployment to someone trying to bound one.
QUERY_QUOTA_REQUESTS=unlimited

# LLM tokens allowed per key per window — usage.totalTokens, summed across tool rounds, so a
# report-generating answer that made six device calls counts every round it paid for.
# Same value grammar as QUERY_QUOTA_REQUESTS above; refuses with 429 quota_tokens_exceeded.
#
# TRAP, and it is not fixable: this is enforced against tokens ALREADY SPENT. A prompt's cost is
# unknown until the provider answers, so the request that crosses the line is allowed to finish
# and the NEXT one is refused. Budget for an overshoot of up to one LLM_MAX_TOKENS answer.
QUERY_QUOTA_TOKENS=unlimited

# Window length. A UNIT SUFFIX IS REQUIRED — s, m, h, d, w. "7d", "24h", "30m", "4w".
# A bare integer is rejected on purpose: DEVICE_API_TIMEOUT_MS gets away with being unitless
# because 10000 is legible, but a week is 604800000 and nobody can check that at a glance.
#
# TRAP: windows are FIXED and EPOCH-ALIGNED, not rolling. Two consequences worth knowing before
# you pick a value:
#   - a caller can spend a full allowance on each side of a boundary, so 2x the limit is
#     reachable in a burst across the seam;
#   - alignment is to the Unix epoch, so a 7d window rolls over on THURSDAY 00:00 UTC — not
#     Sunday, and not on the caller's first request. Prefer 1d/24h if the reset day matters.
QUERY_QUOTA_WINDOW=30d

# What the counters key on:
#   caller -> one bucket per caller identity: sha256 of the Authorization bearer token,
#             falling back to client IP, falling back to a single "anonymous" bucket.
#   global -> one bucket for the entire deployment.
#
# READ THIS BEFORE CHOOSING `caller`. This service authenticates nobody. It forwards the
# caller's token to the device API and lets that API judge it, so unlike the upstream backend it
# has NO user id and NO organization to key on:
#   - The token is a JWT, but decoding it unverified would key quota on a claim any caller can
#     forge by editing the payload — i.e. a quota anyone can reset. Hashing the whole token
#     instead means a second bucket costs you a second token the device API accepts.
#   - There is no org counter. Resolving a caller's organization needs a backend round-trip this
#     service does not make. `global` is the honest stand-in on a single-tenant deployment.
#   - The bundled frontend sends NO Authorization header at all (frontend/js/api.js), so today
#     `caller` lands on the IP branch for every browser request.
#   - Express `trust proxy` is NOT set in src/app.ts, so req.ip is the socket peer. Behind Cloud
#     Run or any load balancer that is the proxy's address — every caller, one bucket. Until the
#     frontend sends a token, `global` is the setting whose behavior matches its name.
QUERY_QUOTA_SCOPE=caller

# STORAGE CAVEAT — counters live in process memory (src/quota/InMemoryQuotaStore.ts):
#   - they RESET ON EVERY REDEPLOY and on crash; a restart hands the fleet a fresh allowance;
#   - they are PER INSTANCE, so N containers enforce N separate quotas and the effective limit
#     is limit x N;
#   - read-then-record is not transactional, so concurrent requests from one key can overshoot
#     by a request or two.
# Fine for deciding which policy the team wants. Not fine as the gate on a paid tier — that
# needs a shared store behind the QuotaStore interface.

# ---- Retrieval ----
# Cap on prior messages accepted per request. History is client-controlled input;
# without a cap one conversation can grow the prompt, and the bill, without limit.
MAX_HISTORY_MESSAGES=20

# freshwater | saltwater. Selects the conductivity and turbidity normal ranges written into
# the system prompt. Left commented rather than set, because it defaults to `freshwater` and
# flipping it changes the prompt every chat answer is grounded in — the two cleared test pods
# are different water types, so ONE deployment cannot serve both correctly (README §7e).
# The report path does not use this; it reads each device's own operatingEnvironment.
# WATER_TYPE=freshwater

# Where corpus text is read from: artifact (local ingestion output, no credentials)
# or firestore (required for a measured bake-off run, so read costs are counted).
CORPUS_SOURCE=artifact

# Which retrieval arm answers when the request names none. Keep this as `stub` here: it is the
# config default, it is what README §3 promises a fresh checkout does, and it needs no
# credentials. `firestore-direct` reads `data/corpus/corpus.json`, which is gitignored — shipping
# it as the example default meant `cp .env.example .env` produced a service that threw on the
# first question, and made the test suite's behavior depend on an untracked file.
DEFAULT_RETRIEVAL=firestore-direct
DEBUG_RETRIEVAL=false
