# dependencies
node_modules/

# build output
dist/

# env & secrets
.env
.env.local
.env.*.local
serviceAccountKey.json

# logs
*.log
npm-debug.log*

# test coverage
coverage/

# generated report PDFs (generate_report tool output -- local disk, not a tracked deliverable)
generated_reports/

# editor / OS
.DS_Store
.vscode/

# claude worktrees / local agent state
.claude/

# OCR transcripts for scanned PDFs. NOT a legacy artifact — `src/ingestion/extract.ts` reads
# `.ocr_cache/<filename>.txt` and hard-errors when it is missing, so ingesting a scanned document
# on a fresh clone requires re-running OCR or being handed the .txt (documents/README.md).
.ocr_cache/

# Sensor data — confidential per CLAUDE.md privacy posture.
#
# `data/*` stays a blanket ignore and `data/results/` is the single exception, because the two
# kinds of thing under `data/` have opposite defaults. Confidential pulls (`backend-surface/`,
# `device-fields/`) and large derived caches (`corpus/`, `embeddings/`) must never be committed;
# evaluation results must be, since the reports cite them as evidence and re-earning them costs
# money. An allow-list keeps a new confidential subdirectory ignored by default — a deny-list
# would leak it the day someone adds one and forgets this file.
data/*
!data/.gitkeep
!data/results/

# Source documents — public EPA/USGS but bulky
documents/*
!documents/.gitkeep

# Migration planning artifacts are tracked deliverables (see CLAUDE.md)
!docs/migration/
